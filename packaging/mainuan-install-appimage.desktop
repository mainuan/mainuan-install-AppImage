[Desktop Entry]
Type=Application
Name=Mainuan AppImage Installer
Comment=Inspects and installs AppImage files as Debian packages
Exec=/usr/bin/mainuan-install-appimage %f
TryExec=/usr/bin/mainuan-install-appimage
Icon=mainuan-install-appimage
Terminal=false
NoDisplay=true
MimeType=application/vnd.appimage;
Categories=System;
StartupNotify=true

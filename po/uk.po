msgid "dpkg-query failed; it is not safe to continue."
msgstr "Помилка dpkg-query; продовжувати небезпечно."

#: src/mainuan_install_appimage/installer.py:68
msgid "The dpkg-query response is malformed."
msgstr "Відповідь dpkg-query є помилково форматованою."

#: src/mainuan_install_appimage/installer.py:70
msgid ""
"The package is in a partial state in dpkg. Examine it before continuing."
msgstr ""
"Пакунок перебуває у частковому стані у dpkg. Перевірте його, перш ніж "
"продовжувати."

#: src/mainuan_install_appimage/installer.py:105
msgid ""
"A package with this identifier already exists that was not installed by this "
"tool. It will be preserved."
msgstr ""
"Вже існує пакунок із цим ідентифікатором, який було встановлено не цим "
"інструментом. Його буде збережено."

#: src/mainuan_install_appimage/installer.py:117
msgid ""
"The package identifier belongs to another installation. No file will be "
"replaced."
msgstr ""
"Ідентифікатор пакунка належить до іншого встановлення. Жоден файл не буде "
"замінено."

#: src/mainuan_install_appimage/installer.py:139
msgid ""
"A legacy installation with this name was detected. The dpkg database and the "
"existing files will not be repaired automatically."
msgstr ""
"Виявлено застаріле встановлення з цією назвою. Базу даних dpkg і наявні "
"файли не буде виправлено автоматично."

#: src/mainuan_install_appimage/installer.py:158
msgid "The installer's fallback icon is not available."
msgstr "Резервна піктограма засобу встановлення недоступна."

#: src/mainuan_install_appimage/installer.py:172
msgid "Icon conversion cannot run as root."
msgstr "Перетворення піктограм не можна виконувати від імені root."

#: src/mainuan_install_appimage/installer.py:188
msgid "Could not prepare the package icons."
msgstr "Не вдалося приготувати піктограми пакунка."

#: src/mainuan_install_appimage/installer.py:216
#, python-brace-format
msgid "Launcher categories refused: {error}"
msgstr "Категорії засобу запуску відхилено: {error}"

#: src/mainuan_install_appimage/installer.py:295
#, python-brace-format
msgid "The destination {path} is not a secure directory."
msgstr "Місце призначення {path} не є безпечним каталогом."

#: src/mainuan_install_appimage/installer.py:303
#, python-brace-format
msgid "The destination {path} already exists and is not a regular file."
msgstr "Місце призначення {path} вже існує і не є звичайним файлом."

#: src/mainuan_install_appimage/installer.py:305
#, python-brace-format
msgid ""
"The destination {path} already exists without a valid managed installation."
msgstr ""
"Місце призначення {path} вже існує, але не має коректного керованого "
"встановлення."

#: src/mainuan_install_appimage/installer.py:312
#, python-brace-format
msgid "The file {path} does not belong to a package managed by this tool."
msgstr "Файл {path} не належить до пакунка, яким керує цей інструмент."

#: src/mainuan_install_appimage/installer.py:326
#, python-brace-format
msgid "Could not prepare the package: {error}"
msgstr "Не вдалося приготувати пакунок: {error}"

#: src/mainuan_install_appimage/installer.py:338
#, python-brace-format
msgid "dpkg-deb could not build the package: {detail}"
msgstr "dpkg-deb не вдалося зібрати пакунок: {detail}"

#: src/mainuan_install_appimage/installer.py:339
#: src/mainuan_install_appimage/installer.py:497
msgid "unknown error"
msgstr "невідома помилка"

#: src/mainuan_install_appimage/installer.py:350
msgid "The prepared package's control data does not match the installation."
msgstr "Керівні дані приготованого пакунка не відповідають встановленню."

#: src/mainuan_install_appimage/installer.py:354
msgid "Invalid or oversized Debian control data."
msgstr "Некоректні або надто великі керівні дані Debian."

#: src/mainuan_install_appimage/installer.py:359
msgid "The package contains control files that are not allowed."
msgstr "Пакунок містить недозволені керівні файли."

#: src/mainuan_install_appimage/installer.py:362
msgid "Invalid Debian control ownership."
msgstr "Некоректне власництво керівних даних Debian."

#: src/mainuan_install_appimage/installer.py:365
msgid "Invalid Debian control file."
msgstr "Некоректний керівний файл Debian."

#: src/mainuan_install_appimage/installer.py:367
msgid "Debian control fields not allowed."
msgstr "Недозволені керівні поля Debian."

#: src/mainuan_install_appimage/installer.py:369
msgid "Invalid Debian control directory."
msgstr "Некоректний керівний каталог Debian."

#: src/mainuan_install_appimage/installer.py:404
msgid "Duplicate or oversized Debian manifest."
msgstr "Дублікат або надто великий маніфест Debian."

#: src/mainuan_install_appimage/installer.py:407
msgid "Invalid Debian ownership metadata."
msgstr "Некоректні метадані власництва Debian."

#: src/mainuan_install_appimage/installer.py:410
msgid "Directory outside the allowed manifest."
msgstr "Каталог поза дозволеним маніфестом."

#: src/mainuan_install_appimage/installer.py:413
msgid "File or link outside the allowed manifest."
msgstr "Файл або посилання поза дозволеним маніфестом."

#: src/mainuan_install_appimage/installer.py:416
msgid "Invalid Debian file permissions."
msgstr "Некоректні права доступу до файлів Debian."

#: src/mainuan_install_appimage/installer.py:418
msgid "Size outside the allowed manifest."
msgstr "Розмір поза дозволеним маніфестом."

#: src/mainuan_install_appimage/installer.py:424
msgid "The AppImage in the package does not match the validated snapshot."
msgstr "AppImage у пакунку не відповідає перевіреному знімку."

#: src/mainuan_install_appimage/installer.py:426
msgid "Incomplete or invalid Debian manifest."
msgstr "Неповний або некоректний маніфест Debian."

#: src/mainuan_install_appimage/installer.py:428
#, python-brace-format
msgid "Could not validate the package files: {error}"
msgstr "Не вдалося перевірити файли пакунка: {error}"

#: src/mainuan_install_appimage/installer.py:443
msgid "Could not identify the system architecture."
msgstr "Не вдалося визначити архітектуру системи."

#: src/mainuan_install_appimage/installer.py:447
#, python-brace-format
msgid ""
"The AppImage is {architecture}, but the system is {host_architecture}. The "
"installation was canceled."
msgstr ""
"AppImage має архітектуру {architecture}, а система — {host_architecture}. "
"Встановлення скасовано."

#: src/mainuan_install_appimage/installer.py:464
msgid "The package manager is busy. Try again after the other transaction."
msgstr ""
"Засіб керування пакунками зайнятий. Повторіть спробу після завершення іншої "
"транзакції."

#: src/mainuan_install_appimage/installer.py:477
msgid "The file changed since the inspection. Select it again."
msgstr "Файл змінився після перевірки. Виберіть його ще раз."

#: src/mainuan_install_appimage/installer.py:499
#, python-brace-format
msgid ""
"dpkg did not complete the transaction. The previous installation was not "
"removed beforehand; dpkg itself may leave a partially configured "
"transaction. Details: {details}"
msgstr ""
"dpkg не завершив транзакцію. Попереднє встановлення не було вилучено "
"заздалегідь; сам dpkg може залишити частково налаштовану транзакцію. "
"Подробиці: {details}"

#: src/mainuan_install_appimage/installer.py:504
msgid "Installation completed by dpkg."
msgstr "dpkg завершив встановлення."

#: src/mainuan_install_appimage/installer.py:509
msgid "The temporary copy identifier is invalid."
msgstr "Ідентифікатор тимчасової копії є некоректним."

#: src/mainuan_install_appimage/installer.py:518
msgid "The file is not in the allowed temporary area."
msgstr "Файл не перебуває у дозволеній тимчасовій області."

#: src/mainuan_install_appimage/installer.py:533
msgid "Could not validate the secure temporary file."
msgstr "Не вдалося перевірити безпечний тимчасовий файл."

#: src/mainuan_install_appimage/installer.py:549
msgid "The temporary area or the file has invalid permissions."
msgstr "Тимчасова область або файл мають некоректні права доступу."

#: src/mainuan_install_appimage/installer.py:566
msgid "The copy exceeded the size or time limit."
msgstr "Копіювання перевищило обмеження розміру або часу."

#: src/mainuan_install_appimage/installer.py:573
msgid "The temporary copy does not match the inspected file."
msgstr "Тимчасова копія не відповідає перевіреному файлу."

#: src/mainuan_install_appimage/privileged.py:24
msgid "This helper can only be started by PolicyKit."
msgstr "Цю допоміжну програму може запускати лише PolicyKit."

#: src/mainuan_install_appimage/privileged.py:31
msgid "Could not identify the user who requested the installation."
msgstr "Не вдалося визначити користувача, який попросив встановлення."

#: src/mainuan_install_appimage/privileged.py:34
msgid "Unrecognized administrative operation."
msgstr "Нерозпізнана адміністративна дія."

#: src/mainuan_install_appimage/privileged.py:52
msgid "File received and hash verified."
msgstr "Файл отримано, хеш перевірено."

#: src/mainuan_install_appimage/reduced.py:35
msgid "The inspection process did not drop all privileges."
msgstr "Процес перевірки не позбувся усіх привілеїв."

#: src/mainuan_install_appimage/reduced.py:37
msgid "Could not block new privileges."
msgstr "Не вдалося заблокувати нові привілеї."

#: src/mainuan_install_appimage/reduced.py:41
msgid "The inspection process still has capabilities."
msgstr "Процес перевірки все ще має можливості (capabilities)."

#: src/mainuan_install_appimage/reduced.py:73
msgid "Invalid input descriptor."
msgstr "Некоректний дескриптор вхідних даних."

#: src/mainuan_install_appimage/reduced.py:77
msgid ""
"Operational limit: parser memory; address space limit=1073741824 bytes; "
"exact usage unavailable."
msgstr ""
"Робоче обмеження: пам'ять обробника; обмеження адресного простору=1073741824 "
"байтів; точні дані щодо використання недоступні."

#: src/mainuan_install_appimage/staging.py:27
msgid "The environment does not provide a secure temporary directory."
msgstr "Середовище не надає безпечного тимчасового каталогу."

#: src/mainuan_install_appimage/staging.py:32
msgid "The secure temporary directory is not available."
msgstr "Безпечний тимчасовий каталог недоступний."

#: src/mainuan_install_appimage/staging.py:39
msgid "The secure temporary directory has invalid permissions."
msgstr "Безпечний тимчасовий каталог має некоректні права доступу."

#: src/mainuan_install_appimage/staging.py:52
#, python-brace-format
msgid "Could not read the selected file: {error}"
msgstr "Не вдалося прочитати вибраний файл: {error}"

#: src/mainuan_install_appimage/staging.py:64
msgid "Could not prepare the secure temporary area."
msgstr "Не вдалося приготувати безпечну тимчасову область."

#: src/mainuan_install_appimage/staging.py:72
msgid "The secure temporary area has invalid permissions."
msgstr "Безпечна тимчасова область має некоректні права доступу."

#: src/mainuan_install_appimage/staging.py:79
msgid "The selected file is not regular or exceeds the limit."
msgstr "Вибраний файл не є звичайним файлом або перевищує обмеження."

#: src/mainuan_install_appimage/staging.py:93
msgid "Copying the file to a protected temporary area…"
msgstr "Копіювання файла до захищеної тимчасової області…"

#: src/mainuan_install_appimage/staging.py:102
msgid "The selected file exceeds the size limit."
msgstr "Вибраний файл перевищує обмеження розміру."

#: src/mainuan_install_appimage/staging.py:114
msgid "The file was changed during the copy; select it again."
msgstr "Файл змінився під час копіювання. Виберіть його ще раз."

#: src/mainuan_install_appimage/staging.py:116
msgid "Validating ELF, architecture, SquashFS and metadata…"
msgstr "Перевірка ELF, архітектури, SquashFS і метаданих…"

#: src/mainuan_install_appimage/staging.py:119
msgid "The temporary copy does not match the selected file."
msgstr "Тимчасова копія не відповідає вибраному файлу."

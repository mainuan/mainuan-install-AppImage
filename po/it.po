msgstr "errore sconosciuto"

#: src/mainuan_install_appimage/installer.py:350
msgid "The prepared package's control data does not match the installation."
msgstr ""
"I dati di controllo del pacchetto preparato non corrispondono "
"all'installazione."

#: src/mainuan_install_appimage/installer.py:354
msgid "Invalid or oversized Debian control data."
msgstr "Dati di controllo Debian non validi o troppo grandi."

#: src/mainuan_install_appimage/installer.py:359
msgid "The package contains control files that are not allowed."
msgstr "Il pacchetto contiene file di controllo non consentiti."

#: src/mainuan_install_appimage/installer.py:362
msgid "Invalid Debian control ownership."
msgstr "Proprietà di controllo Debian non valida."

#: src/mainuan_install_appimage/installer.py:365
msgid "Invalid Debian control file."
msgstr "File di controllo Debian non valido."

#: src/mainuan_install_appimage/installer.py:367
msgid "Debian control fields not allowed."
msgstr "Campi di controllo Debian non consentiti."

#: src/mainuan_install_appimage/installer.py:369
msgid "Invalid Debian control directory."
msgstr "Cartella di controllo Debian non valida."

#: src/mainuan_install_appimage/installer.py:404
msgid "Duplicate or oversized Debian manifest."
msgstr "Manifesto Debian duplicato o troppo grande."

#: src/mainuan_install_appimage/installer.py:407
msgid "Invalid Debian ownership metadata."
msgstr "Metadati di proprietà Debian non validi."

#: src/mainuan_install_appimage/installer.py:410
msgid "Directory outside the allowed manifest."
msgstr "Cartella al di fuori del manifesto consentito."

#: src/mainuan_install_appimage/installer.py:413
msgid "File or link outside the allowed manifest."
msgstr "File o collegamento al di fuori del manifesto consentito."

#: src/mainuan_install_appimage/installer.py:416
msgid "Invalid Debian file permissions."
msgstr "Permessi dei file Debian non validi."

#: src/mainuan_install_appimage/installer.py:418
msgid "Size outside the allowed manifest."
msgstr "Dimensione al di fuori del manifesto consentito."

#: src/mainuan_install_appimage/installer.py:424
msgid "The AppImage in the package does not match the validated snapshot."
msgstr "L'AppImage nel pacchetto non corrisponde all'istantanea convalidata."

#: src/mainuan_install_appimage/installer.py:426
msgid "Incomplete or invalid Debian manifest."
msgstr "Manifesto Debian incompleto o non valido."

#: src/mainuan_install_appimage/installer.py:428
#, python-brace-format
msgid "Could not validate the package files: {error}"
msgstr "Impossibile convalidare i file del pacchetto: {error}"

#: src/mainuan_install_appimage/installer.py:443
msgid "Could not identify the system architecture."
msgstr "Impossibile identificare l'architettura del sistema."

#: src/mainuan_install_appimage/installer.py:447
#, python-brace-format
msgid ""
"The AppImage is {architecture}, but the system is {host_architecture}. The "
"installation was canceled."
msgstr ""
"L'AppImage è {architecture}, ma il sistema è {host_architecture}. "
"L'installazione è stata annullata."

#: src/mainuan_install_appimage/installer.py:464
msgid "The package manager is busy. Try again after the other transaction."
msgstr "Il gestore dei pacchetti è occupato. Riprova dopo l'altra transazione."

#: src/mainuan_install_appimage/installer.py:477
msgid "The file changed since the inspection. Select it again."
msgstr "Il file è cambiato dopo l'ispezione. Selezionalo di nuovo."

#: src/mainuan_install_appimage/installer.py:499
#, python-brace-format
msgid ""
"dpkg did not complete the transaction. The previous installation was not "
"removed beforehand; dpkg itself may leave a partially configured "
"transaction. Details: {details}"
msgstr ""
"dpkg non ha completato la transazione. L'installazione precedente non è "
"stata rimossa in anticipo; dpkg stesso potrebbe lasciare una transazione "
"configurata parzialmente. Dettagli: {details}"

#: src/mainuan_install_appimage/installer.py:504
msgid "Installation completed by dpkg."
msgstr "Installazione completata da dpkg."

#: src/mainuan_install_appimage/installer.py:509
msgid "The temporary copy identifier is invalid."
msgstr "L'identificativo della copia temporanea non è valido."

#: src/mainuan_install_appimage/installer.py:518
msgid "The file is not in the allowed temporary area."
msgstr "Il file non si trova nell'area temporanea consentita."

#: src/mainuan_install_appimage/installer.py:533
msgid "Could not validate the secure temporary file."
msgstr "Impossibile convalidare il file temporaneo sicuro."

#: src/mainuan_install_appimage/installer.py:549
msgid "The temporary area or the file has invalid permissions."
msgstr "L'area temporanea o il file hanno permessi non validi."

#: src/mainuan_install_appimage/installer.py:566
msgid "The copy exceeded the size or time limit."
msgstr "La copia ha superato il limite di dimensione o di tempo."

#: src/mainuan_install_appimage/installer.py:573
msgid "The temporary copy does not match the inspected file."
msgstr "La copia temporanea non corrisponde al file ispezionato."

#: src/mainuan_install_appimage/privileged.py:24
msgid "This helper can only be started by PolicyKit."
msgstr "Questo programma ausiliario può essere avviato solo da PolicyKit."

#: src/mainuan_install_appimage/privileged.py:31
msgid "Could not identify the user who requested the installation."
msgstr "Impossibile identificare l'utente che ha richiesto l'installazione."

#: src/mainuan_install_appimage/privileged.py:34
msgid "Unrecognized administrative operation."
msgstr "Operazione amministrativa non riconosciuta."

#: src/mainuan_install_appimage/privileged.py:52
msgid "File received and hash verified."
msgstr "File ricevuto e hash verificato."

#: src/mainuan_install_appimage/reduced.py:35
msgid "The inspection process did not drop all privileges."
msgstr "Il processo di ispezione non ha rinunciato a tutti i privilegi."

#: src/mainuan_install_appimage/reduced.py:37
msgid "Could not block new privileges."
msgstr "Impossibile bloccare nuovi privilegi."

#: src/mainuan_install_appimage/reduced.py:41
msgid "The inspection process still has capabilities."
msgstr "Il processo di ispezione ha ancora delle capability."

#: src/mainuan_install_appimage/reduced.py:73
msgid "Invalid input descriptor."
msgstr "Descrittore di input non valido."

#: src/mainuan_install_appimage/reduced.py:77
msgid ""
"Operational limit: parser memory; address space limit=1073741824 bytes; "
"exact usage unavailable."
msgstr ""
"Limite operativo: memoria dell'analizzatore; limite dello spazio di "
"indirizzamento=1073741824 byte; utilizzo esatto non disponibile."

#: src/mainuan_install_appimage/staging.py:27
msgid "The environment does not provide a secure temporary directory."
msgstr "L'ambiente non fornisce una cartella temporanea sicura."

#: src/mainuan_install_appimage/staging.py:32
msgid "The secure temporary directory is not available."
msgstr "La cartella temporanea sicura non è disponibile."

#: src/mainuan_install_appimage/staging.py:39
msgid "The secure temporary directory has invalid permissions."
msgstr "La cartella temporanea sicura ha permessi non validi."

#: src/mainuan_install_appimage/staging.py:52
#, python-brace-format
msgid "Could not read the selected file: {error}"
msgstr "Impossibile leggere il file selezionato: {error}"

#: src/mainuan_install_appimage/staging.py:64
msgid "Could not prepare the secure temporary area."
msgstr "Impossibile preparare l'area temporanea sicura."

#: src/mainuan_install_appimage/staging.py:72
msgid "The secure temporary area has invalid permissions."
msgstr "L'area temporanea sicura ha permessi non validi."

#: src/mainuan_install_appimage/staging.py:79
